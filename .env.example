# Copy this file to .env and fill in the values.
# Never commit the real .env - it contains tokens/secrets.

# Bot token, starts with xoxb- (Slack App -> OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-...

# App-level token, starts with xapp- (Slack App -> Basic Information -> App-Level Tokens)
# Requires the connections:write scope. Needed for Socket Mode.
SLACK_APP_TOKEN=xapp-...

# OpenRouter API key (openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: list of models, in priority order, separated by commas.
# The first one is tried first; if it hits a rate limit (429), it automatically falls
# back to the next one, and the exhausted model stays "on hold" until the next UTC midnight.
# Check the current list of free models at https://openrouter.ai/models before locking in.
OPENROUTER_MODELS=openrouter/free,deepseek/deepseek-chat-v3-0324:free

# Optional: used in the HTTP-Referer header sent to OpenRouter (good practice,
# helps with usage attribution). Can be the URL of your workspace or repository.
APP_URL=

# Optional: SQLite file path. Default: ./slack-translator.db
DB_PATH=slack-translator.db
